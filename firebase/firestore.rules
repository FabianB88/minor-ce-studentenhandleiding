rules_version = '2';

// Gedeeld scorebord van de learning game (studentenhandleiding, game.html).
// Iedereen mag scores lezen en één score per ronde toevoegen; niets mag worden gewijzigd of verwijderd.
// De validatie houdt de inhoud klein en in de verwachte vorm, zodat de collectie niet misbruikt kan worden.
service cloud.firestore {
  match /databases/{database}/documents {
    match /learninggame_scores/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['naam', 'modus', 'score', 'tijd', 'max', 'datum'])
        && request.resource.data.naam is string
        && request.resource.data.naam.size() >= 1 && request.resource.data.naam.size() <= 24
        && request.resource.data.modus in ['sprint', 'schijf', 'honderd', 'miljonair', 'lingo']
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.tijd is int && request.resource.data.tijd >= 0 && request.resource.data.tijd <= 7200
        && request.resource.data.max is int && request.resource.data.max >= 1 && request.resource.data.max <= 100
        && request.resource.data.datum == request.time;
      allow update, delete: if false;
    }
  }
}
